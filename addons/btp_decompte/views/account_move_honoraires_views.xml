<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extension de la vue formulaire Facture pour le modèle Honoraires / Consultant -->
    <record id="view_move_form_inherit_honoraires" model="ir.ui.view">
        <field name="name">account.move.form.inherit.honoraires</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            
            <!-- 1. BOUTON D'IMPRESSION DANS L'EN-TÊTE -->
            <xpath expr="//header" position="inside">
                <button name="action_print_facture_honoraires"
                        string="Imprimer Facture Honoraires (PDF)"
                        type="object"
                        class="btn-primary fw-bold"
                        icon="fa-print"
                        invisible="facture_modele_code != 'honoraires_consultant'"/>
            </xpath>

            <!-- 2. MASQUER L'ONGLET BORDEREAU LORSQUE LE MODÈLE HONORAIRES EST CHOISI -->
            <xpath expr="//page[@name='facture_modele_page']" position="attributes">
                <attribute name="invisible">decompte_id or petit_marche_id or facture_modele_code == 'honoraires_consultant'</attribute>
            </xpath>

            <!-- 3. NOUVEL ONGLET DÉDIÉ : FACTURE HONORAIRES / CONSULTANT (PLACÉ EN TÊTE) -->
            <xpath expr="//page[@id='invoice_tab']" position="before">
                <page string="Facture Honoraires / Consultant" 
                      name="facture_honoraires_page" 
                      invisible="facture_modele_code != 'honoraires_consultant'">
                    
                    <div class="row">
                        
                        <!-- VOLET GAUCHE (4 COLONNES) : SÉLECTION & PRÉVISUALISATION VISUELLE -->
                        <div class="col-md-4 border-end pe-3">
                            <div class="alert alert-dark py-2 px-3 mb-3 text-white" style="background-color: #2c3e50;" role="status">
                                <strong><i class="fa fa-file-text-o me-1" title="Modèle"/> Modèle Honoraires / Consultant</strong><br/>
                                <span class="small text-light">Document officiel d'honoraires d'experts avec tranches et retenue à la source.</span>
                            </div>
                            
                            <group>
                                <field name="facture_modele_id" options="{'no_create': True}" widget="many2one" string="Modèle Choisi"/>
                            </group>

                            <div class="text-center p-2 bg-light border rounded shadow-sm mt-2">
                                <field name="facture_modele_image" widget="image" class="img-fluid rounded" style="max-height: 420px; object-fit: contain; width: 100%;" readonly="1"/>
                            </div>
                            <div class="text-muted small text-center mt-2 fst-italic">
                                Rendu visuel officiel du document imprimé
                            </div>

                            <div class="card mt-3 border-0 bg-light shadow-sm">
                                <div class="card-body p-3">
                                    <h6 class="text-primary fw-bold mb-2">
                                        <i class="fa fa-info-circle me-1" title="Guide"/> Guide d'utilisation
                                    </h6>
                                    <ol class="small ps-3 mb-0" style="line-height: 1.5;">
                                        <li>Renseignez le client et l'objet de la mission.</li>
                                        <li>Saisissez le montant des <strong>Honoraires (Ligne 1)</strong>.</li>
                                        <li>Saisissez le montant des <strong>Frais Remboursables (Ligne 2)</strong>.</li>
                                        <li>Les <strong>lignes 3 à 10</strong> et la somme en lettres sont <strong>automatiquement calculées</strong> !</li>
                                        <li>Cliquez sur <strong>« Imprimer Facture Honoraires »</strong> pour générer le PDF officiel conforme au modèle.</li>
                                    </ol>
                                </div>
                            </div>
                        </div>

                        <!-- VOLET DROIT (8 COLONNES) : SAISIE, CALCULS AUTOMATIQUES & APERÇU -->
                        <div class="col-md-8 ps-3">
                            
                            <!-- BLOC 1 : INFORMATIONS GÉNÉRALES & SIGNATAIRE -->
                            <div class="card mb-3 border-0 shadow-sm bg-light">
                                <div class="card-header text-white fw-bold py-2" style="background-color: #34495e;">
                                    <i class="fa fa-pencil-square-o me-2" title="En-tête"/> Informations Générales &amp; Signataire
                                </div>
                                <div class="card-body py-2">
                                    <group>
                                        <group>
                                            <field name="honoraire_city" placeholder="Ex: Ouagadougou"/>
                                            <field name="invoice_date" string="Date de facture"/>
                                        </group>
                                        <group>
                                            <field name="honoraire_signataire_titre" placeholder="Ex: Signataire / Le Consultant"/>
                                            <field name="honoraire_signataire_nom" placeholder="Nom et Prénoms du Signataire"/>
                                        </group>
                                    </group>
                                    <group>
                                        <field name="honoraire_objet" placeholder="Ex: Prestations intellectuelles pour la mission d'études techniques..." rows="2"/>
                                    </group>
                                </div>
                            </div>

                            <!-- BLOC 2 : CADRE DE SAISIE PRINCIPALE (HONORAIRES & FRAIS) -->
                            <div class="card mb-3 border-primary shadow-sm">
                                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-2">
                                    <span class="fw-bold fs-6">
                                        <i class="fa fa-edit me-2" title="Saisie"/> Saisie Principale : Honoraires &amp; Frais Remboursables
                                    </span>
                                    <span class="badge bg-success text-white">Calcul Automatique Instantané</span>
                                </div>
                                <div class="card-body">
                                    <div class="alert alert-success d-flex align-items-center mb-3 p-3 border-start border-4 border-success" role="status">
                                        <i class="fa fa-magic fa-2x text-success me-3" title="Calcul automatique"/>
                                        <div>
                                            <h6 class="fw-bold text-success mb-1">CALCULS DES 10 LIGNES EN TEMPS RÉEL</h6>
                                            <span>Renseignez les <strong>Honoraires</strong> et les <strong>Frais Remboursables</strong> : le Total Prestation, les 3 Tranches, la Retenue à la source (5%), le Net à Payer et l'arrêté en lettres se remplissent instantanément !</span>
                                        </div>
                                    </div>

                                    <div class="row g-3">
                                        <!-- CASE 1 : HONORAIRES DES CONSULTANTS -->
                                        <div class="col-md-6">
                                            <div class="p-3 border border-2 border-primary rounded bg-white h-100 shadow-sm">
                                                <span class="o_form_label fw-bold text-primary mb-1 d-block">
                                                    <i class="fa fa-briefcase me-1" title="Honoraires"/> 1. Honoraires des consultants :
                                                </span>
                                                <field name="honoraire_montant"
                                                       widget="monetary"
                                                       options="{'currency_field': 'currency_id'}"
                                                       class="fw-bold fs-4 text-primary w-100"
                                                       placeholder="0.00"/>
                                                <div class="text-muted small mt-1">Montant total des honoraires convenu</div>
                                            </div>
                                        </div>

                                        <!-- CASE 2 : FRAIS REMBOURSABLES (100%) -->
                                        <div class="col-md-6">
                                            <div class="p-3 border border-2 border-info rounded bg-white h-100 shadow-sm">
                                                <span class="o_form_label fw-bold text-info mb-1 d-block">
                                                    <i class="fa fa-plane me-1" title="Frais"/> 2. Frais Remboursables (100%) :
                                                </span>
                                                <field name="honoraire_frais_remboursables"
                                                       widget="monetary"
                                                       options="{'currency_field': 'currency_id'}"
                                                       class="fw-bold fs-4 text-info w-100"
                                                       placeholder="0.00"/>
                                                <div class="text-muted small mt-1">Déplacements, hébergements, rapports, communications</div>
                                            </div>
                                        </div>

                                        <!-- UNITÉ ET QUANTITÉ -->
                                        <div class="col-md-6">
                                            <div class="p-2 border rounded bg-light">
                                                <span class="o_form_label text-dark fw-bold mb-1 d-block">Unité :</span>
                                                <field name="honoraire_unite" placeholder="Ex: Forfait, Mois, Mission"/>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="p-2 border rounded bg-light">
                                                <span class="o_form_label text-dark fw-bold mb-1 d-block">Quantité :</span>
                                                <field name="honoraire_quantite"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- BLOC 3 : RÉCAPITULATIF DES 10 LIGNES MÉTIER CALCULÉES -->
                            <div class="card mb-3 border-dark shadow-sm">
                                <div class="card-header bg-dark text-white fw-bold py-2">
                                    <i class="fa fa-calculator me-2" title="Lignes"/> Les 10 Lignes Métier Calculées
                                </div>
                                <div class="card-body">
                                    <div class="row g-2">
                                        <!-- Ligne 3 : Total Prestation -->
                                        <div class="col-md-6">
                                            <div class="p-2 border rounded bg-light">
                                                <small class="text-muted d-block">3. Montant total de la prestation (1 + 2) :</small>
                                                <field name="honoraire_line_3_total_prestation" widget="monetary" options="{'currency_field': 'currency_id'}" class="fw-bold fs-5 text-dark"/>
                                            </div>
                                        </div>
                                        <!-- Ligne 4 : Tranche 1 Honoraires (30%) -->
                                        <div class="col-md-6">
                                            <div class="p-2 border rounded bg-light">
                                                <small class="text-muted d-block">4. Paiement 1ere tranche (Avance 30% Honoraire) :</small>
                                                <field name="honoraire_line_4_tranche_1_honoraire" widget="monetary" options="{'currency_field': 'currency_id'}" class="fw-bold text-dark"/>
                                            </div>
                                        </div>
                                        <!-- Ligne 5 : Tranche 1 Frais (100%) -->
                                        <div class="col-md-6">
                                            <div class="p-2 border rounded bg-light">
                                                <small class="text-muted d-block">5. Paiement 1ere tranche (100% Frais remboursable) :</small>
                                                <field name="honoraire_line_5_tranche_1_frais" widget="monetary" options="{'currency_field': 'currency_id'}" class="fw-bold text-dark"/>
                                            </div>
                                        </div>
                                        <!-- Ligne 6 : Total Règlement Tranche 1 -->
                                        <div class="col-md-6">
                                            <div class="p-2 border rounded bg-light">
                                                <small class="text-muted d-block">6. Total règlement 1ere Tranche (4 + 5) :</small>
                                                <field name="honoraire_line_6_total_tranche_1" widget="monetary" options="{'currency_field': 'currency_id'}" class="fw-bold fs-5 text-primary"/>
                                            </div>
                                        </div>
                                        <!-- Ligne 7 : Tranche 2 (30% Honoraire après 50%) -->
                                        <div class="col-md-6">
                                            <div class="p-2 border rounded bg-light">
                                                <small class="text-muted d-block">7. Paiement 2 ème Tranche 30% Honoraire :</small>
                                                <field name="honoraire_line_7_tranche_2_honoraire" widget="monetary" options="{'currency_field': 'currency_id'}" class="fw-bold text-dark"/>
                                            </div>
                                        </div>
                                        <!-- Ligne 8 : Tranche 3 (40% Honoraire après 100%) -->
                                        <div class="col-md-6">
                                            <div class="p-2 border rounded bg-light">
                                                <small class="text-muted d-block">8. Paiement 3 ème Tranche 40% Honoraire :</small>
                                                <field name="honoraire_line_8_tranche_3_honoraire" widget="monetary" options="{'currency_field': 'currency_id'}" class="fw-bold text-dark"/>
                                            </div>
                                        </div>
                                        <!-- Ligne 9 : Retenue 5% -->
                                        <div class="col-md-6">
                                            <div class="p-2 border border-danger rounded bg-white">
                                                <small class="text-danger fw-bold d-block">9. Retenue à la source (5% Tranche 1+2+3) :</small>
                                                <field name="honoraire_line_9_retenue_source" widget="monetary" options="{'currency_field': 'currency_id'}" class="fw-bold text-danger"/>
                                            </div>
                                        </div>
                                        <!-- Ligne 10 : Net à payer Tranche 2+3 (GRISÉ FONCÉ) -->
                                        <div class="col-md-6">
                                            <div class="p-2 rounded text-white shadow-sm" style="background-color: #6c757d; border: 2px solid #343a40;">
                                                <small class="text-white fw-bold d-block">10. Net à payer Tranche 2+3 :</small>
                                                <field name="honoraire_line_10_net_a_payer" widget="monetary" options="{'currency_field': 'currency_id'}" class="fw-bold fs-4 text-white"/>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Arrêté en toutes lettres -->
                                    <div class="p-2 mt-3 bg-light border rounded text-dark">
                                        <span class="fw-bold"><i class="fa fa-font me-1" title="Lettres"/> Arrêtée la présente facture à la somme de : </span>
                                        <field name="honoraire_net_lettres" class="fw-bold text-uppercase text-primary"/>
                                    </div>
                                </div>
                            </div>

                            <!-- BLOC 4 : TAUX & AVANCEMENT (CONFIGURABLE) -->
                            <div class="card mb-3 border-0 bg-light shadow-sm">
                                <div class="card-header bg-secondary text-white fw-bold py-1 small">
                                    <i class="fa fa-sliders me-1" title="Paramètres"/> Taux du modèle &amp; Contrôle d'Avancement de la mission
                                </div>
                                <div class="card-body py-2">
                                    <div class="row g-2">
                                        <div class="col-md-3">
                                            <span class="small fw-bold">Taux Tranche 1 (%)</span>
                                            <field name="honoraire_taux_tranche_1"/>
                                        </div>
                                        <div class="col-md-3">
                                            <span class="small fw-bold">Taux Tranche 2 (%)</span>
                                            <field name="honoraire_taux_tranche_2"/>
                                        </div>
                                        <div class="col-md-3">
                                            <span class="small fw-bold">Taux Tranche 3 (%)</span>
                                            <field name="honoraire_taux_tranche_3"/>
                                        </div>
                                        <div class="col-md-3">
                                            <span class="small fw-bold">Retenue Source (%)</span>
                                            <field name="honoraire_taux_retenue"/>
                                        </div>
                                    </div>
                                    <div class="row g-2 mt-1">
                                        <div class="col-md-6">
                                            <field name="honoraire_prestation_50"/>
                                            <span class="small ms-1">Prestation exécutée à au moins 50%</span>
                                        </div>
                                        <div class="col-md-6">
                                            <field name="honoraire_prestation_100"/>
                                            <span class="small ms-1">Prestation achevée à 100%</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- BLOC 5 : APERÇU DIRECT DU DOCUMENT DU MODÈLE TEL QU'IMPRIMÉ -->
                            <div class="mt-3">
                                <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-2">
                                    <h6 class="text-dark fw-bold mb-0">
                                        <i class="fa fa-eye me-1" title="Aperçu"/> Aperçu Direct du Document Tel Qu'Imprimé
                                    </h6>
                                    <button name="action_print_facture_honoraires" 
                                            string="Imprimer la Facture (PDF)" 
                                            type="object" 
                                            class="btn btn-sm btn-primary fw-bold" 
                                            icon="fa-print"/>
                                </div>
                                <field name="honoraire_preview_html" widget="html" readonly="1" nolabel="1"/>
                            </div>

                        </div>
                    </div>
                </page>
            </xpath>

        </field>
    </record>
</odoo>
