<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_facture_decompte_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="article" style="font-family: 'Helvetica Neue', Arial, sans-serif; font-size: 11px; color: #000; padding: 10px 15px; line-height: 1.35;">
                    
                    <!-- EN-TÊTE SUPÉRIEUR (LOGO OU COORDONNÉES) -->
                    <table t-if="o.company_id.logo or o.company_id.name" style="width: 100%; border-collapse: collapse; margin-bottom: 6px;">
                        <tr>
                            <td style="width: 20%; vertical-align: middle; text-align: left;">
                                <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 60px; max-width: 140px;" alt="Logo"/>
                            </td>
                            <td style="width: 60%; vertical-align: middle; text-align: center;">
                                <div style="font-size: 13px; font-weight: bold; letter-spacing: 0.5px; text-transform: uppercase;">
                                    <t t-esc="o.company_id.name"/>
                                </div>
                                <div style="font-size: 9.5px; color: #333; margin-top: 2px;">
                                    <t t-if="o.company_id.street"><t t-esc="o.company_id.street"/>, </t>
                                    <t t-if="o.company_id.city"><t t-esc="o.company_id.city"/> - </t>
                                    <t t-if="o.company_id.phone">Tél : <t t-esc="o.company_id.phone"/> | </t>
                                    <t t-if="o.company_id.email">Email : <t t-esc="o.company_id.email"/></t>
                                </div>
                                <div t-if="o.company_id.ifu or o.company_id.vat" style="font-size: 9px; color: #444;">
                                    <strong>IFU : </strong><t t-esc="o.company_id.ifu or o.company_id.vat"/>
                                    <t t-if="o.company_id.rccm"> | <strong>RCCM : </strong><t t-esc="o.company_id.rccm"/></t>
                                </div>
                            </td>
                            <td style="width: 20%; text-align: right; vertical-align: middle;">
                                <img t-if="o.qr_code_image" t-att-src="'data:image/png;base64,%s' % o.qr_code_image.decode('utf-8')" style="width: 55px; height: 55px; border: 1px solid #333; padding: 2px;" alt="QR Code"/>
                            </td>
                        </tr>
                    </table>

                    <div t-if="o.company_id.logo or o.company_id.name" style="border-bottom: 1px solid #666; margin-bottom: 12px;"></div>

                    <!-- LIEU ET DATE (EN HAUT À DROITE EXACTEMENT COMME SUR LA PHOTO) -->
                    <div style="text-align: right; font-size: 11.5px; margin-bottom: 15px; margin-right: 5px;">
                        <span style="font-weight: 500;">
                            <t t-esc="o.decompte_btp_city or o.facture_city or 'Ouagadougou'"/> le : 
                            <strong><t t-esc="(o.invoice_date or datetime.date.today()).strftime('%d/%m/%Y')"/></strong>
                        </span>
                    </div>

                    <!-- FACTURE N° (CENTRÉ ET SOULIGNÉ EXACTEMENT COMME SUR LA PHOTO) -->
                    <div style="text-align: center; margin-bottom: 16px;">
                        <span style="font-size: 15px; font-weight: bold; text-transform: uppercase; text-decoration: underline; letter-spacing: 0.5px;">
                            FACTURE N° : <t t-esc="o.name or o.ref or '......................................'"/>
                        </span>
                    </div>

                    <!-- INFORMATIONS DE LA FACTURE (BLOC GAUCHE AVEC INTITULÉS SOULIGNÉS EXACTEMENT COMME SUR LA PHOTO) -->
                    <div style="margin-bottom: 15px; font-size: 11.5px; line-height: 1.6;">
                        <div>
                            <strong style="text-decoration: underline;">Doit :</strong>
                            <span style="margin-left: 8px; font-weight: bold; text-transform: uppercase;">
                                <t t-esc="o.partner_id.name or '..................................................................'"/>
                            </span>
                            <t t-if="o.partner_id.street">
                                <span style="font-size: 10.5px; font-weight: normal;"> - <t t-esc="o.partner_id.street"/></span>
                            </t>
                            <t t-if="o.partner_id.vat">
                                <span style="font-size: 10.5px; font-weight: normal;"> (IFU : <t t-esc="o.partner_id.vat"/>)</span>
                            </t>
                        </div>
                        <div style="margin-top: 3px;">
                            <strong style="text-decoration: underline;">MARCHE N° :</strong>
                            <span style="margin-left: 8px;">
                                <t t-esc="o.decompte_btp_marche_num or '..................................................................'"/>
                            </span>
                        </div>
                        <div style="margin-top: 3px;">
                            <strong style="text-decoration: underline;">OBJET :</strong>
                            <span style="margin-left: 8px; font-weight: 500;">
                                <t t-esc="o.decompte_btp_objet or o.ref or 'Travaux de construction / réhabilitation selon marché'"/>
                            </span>
                        </div>
                        <div style="margin-top: 3px;">
                            <strong style="text-decoration: underline;">FINANCEMENT :</strong>
                            <span style="margin-left: 8px;">
                                <t t-esc="o.decompte_btp_financement or '..................................................................'"/>
                            </span>
                        </div>
                    </div>

                    <!-- TABLEAU PRINCIPAL (EXACTEMENT LES 2 COLONNES ET LES 15 LIGNES DU MODÈLE FOURNI) -->
                    <table style="width: 100%; border-collapse: collapse; border: 2px solid #000; font-size: 10.5px; margin-bottom: 10px;">
                        <thead>
                            <tr style="border-bottom: 2px solid #000; font-weight: bold; background-color: #ffffff;">
                                <th style="border: 1.5px solid #000; width: 75%; padding: 6px 10px; text-transform: uppercase;">DESIGNATION</th>
                                <th style="border: 1.5px solid #000; width: 25%; padding: 6px 10px; text-align: right; text-transform: uppercase;">MONTANT</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- 1. MONTANT DU MARCHE (A) -->
                            <tr style="border: 1px solid #000; font-weight: bold;">
                                <td style="border: 1px solid #000; padding: 5px 10px;">MONTANT DU MARCHE EN FCFA HTVA (MHTVA) (A)</td>
                                <td style="border: 1px solid #000; text-align: right; padding: 5px 10px; font-weight: bold;">
                                    <t t-esc="o.format_monetary_value(o.decompte_btp_a)"/>
                                </td>
                            </tr>

                            <!-- 2. TAUX D'AVANCEMENT (B) -->
                            <tr style="border: 1px solid #000;">
                                <td style="border: 1px solid #000; padding: 5px 10px;">
                                    TAUX D’AVANCEMENT DES PRESTATIONS (TA) en (%) <em>(l’intégralité des chiffres après la virgule)</em> (B)
                                </td>
                                <td style="border: 1px solid #000; text-align: right; padding: 5px 10px; font-weight: bold;">
                                    <t t-esc="('%g' % o.decompte_btp_b) if o.decompte_btp_b else '0'"/> %
                                </td>
                            </tr>

                            <!-- 3. MONTANT HTVA DU PRESENT DECOMPTE (C) -->
                            <tr style="border: 1px solid #000;">
                                <td style="border: 1px solid #000; padding: 5px 10px;">MONTANT HTVA DU PRESENT DECOMPTE (C) = (TA) x (MHTVA)</td>
                                <td style="border: 1px solid #000; text-align: right; padding: 5px 10px; font-weight: bold;">
                                    <t t-esc="o.format_monetary_value(o.decompte_btp_c)"/>
                                </td>
                            </tr>

                            <!-- 4. MONTANT BRUT DES DECOMPTES PRECEDENTS (D) -->
                            <tr style="border: 1px solid #000;">
                                <td style="border: 1px solid #000; padding: 5px 10px;">MONTANT BRUT HTVA DES DECOMPTES PRECEDENTS (D)</td>
                                <td style="border: 1px solid #000; text-align: right; padding: 5px 10px;">
                                    <t t-if="o.decompte_btp_d"><t t-esc="o.format_monetary_value(o.decompte_btp_d)"/></t>
                                    <t t-else="">-</t>
                                </td>
                            </tr>

                            <!-- 5. MONTANT BRUT DU PRESENT DECOMPTE (MB) = (C) - (D) -->
                            <tr style="border: 1.5px solid #000; font-weight: bold; background-color: #f8f9fa;">
                                <td style="border: 1.5px solid #000; text-align: center; padding: 6px 10px; text-transform: uppercase;">
                                    MONTANT BRUT DU PRESENT DECOMPTE (MB) = (C) - (D)
                                </td>
                                <td style="border: 1.5px solid #000; text-align: right; padding: 6px 10px; font-weight: bold;">
                                    <t t-esc="o.format_monetary_value(o.decompte_btp_mb)"/>
                                </td>
                            </tr>

                            <!-- 6. AVANCE DE DEMARRAGE (E) -->
                            <tr style="border: 1px solid #000;">
                                <td style="border: 1px solid #000; padding: 5px 10px;">AVANCE DE DEMARRAGE PERCUE (E) = (A) x (20 / 100)</td>
                                <td style="border: 1px solid #000; text-align: right; padding: 5px 10px;">
                                    <t t-esc="o.format_monetary_value(o.decompte_btp_e)"/>
                                </td>
                            </tr>

                            <!-- 7. REMBOURSEMENT DES AVANCES PRECEDENTES (F) -->
                            <tr style="border: 1px solid #000;">
                                <td style="border: 1px solid #000; padding: 5px 10px;">REMBOURSEMENT DES AVANCES PRECEDENTES (F)</td>
                                <td style="border: 1px solid #000; text-align: right; padding: 5px 10px;">
                                    <t t-if="o.decompte_btp_f"><t t-esc="o.format_monetary_value(o.decompte_btp_f)"/></t>
                                    <t t-else="">-</t>
                                </td>
                            </tr>

                            <!-- 8. LIGNE SEPARATRICE OFFICIELLE : RETENUES A OPERER -->
                            <tr style="border: 1.5px solid #000; font-weight: bold; background-color: #f1f3f5;">
                                <td colspan="2" style="border: 1.5px solid #000; text-align: center; padding: 5px 10px; text-transform: uppercase; letter-spacing: 0.5px;">
                                    RETENUES A OPERER
                                </td>
                            </tr>

                            <!-- 9. REMBOURSEMENT DE L'AVANCE DU PRESENT DECOMPTE (G) -->
                            <tr style="border: 1px solid #000;">
                                <td style="border: 1px solid #000; padding: 5px 10px;">
                                    REMBOURSEMENT DE L’AVANCE DU PRESENT DECOMPTE (G) = (E) x (B-20)/(80-20)
                                </td>
                                <td style="border: 1px solid #000; text-align: right; padding: 5px 10px;">
                                    <t t-if="o.decompte_btp_g"><t t-esc="o.format_monetary_value(o.decompte_btp_g)"/></t>
                                    <t t-else="">-</t>
                                </td>
                            </tr>

                            <!-- 10. RETENUE A LA SOURCE (H) -->
                            <tr style="border: 1px solid #000;">
                                <td style="border: 1px solid #000; padding: 5px 10px;">
                                    RETENUE A LA SOURCE = (MB x 5%) (H)
                                </td>
                                <td style="border: 1px solid #000; text-align: right; padding: 5px 10px;">
                                    <t t-if="o.decompte_btp_h"><t t-esc="o.format_monetary_value(o.decompte_btp_h)"/></t>
                                    <t t-else="">-</t>
                                </td>
                            </tr>

                            <!-- 11. RETENUE ARCOP (I) -->
                            <tr style="border: 1px solid #000;">
                                <td style="border: 1px solid #000; padding: 5px 10px;">
                                    RETENUE ARCOP <em>(retenue opérée en une seule tranche)</em> (A x 0,4%) (I)
                                </td>
                                <td style="border: 1px solid #000; text-align: right; padding: 5px 10px;">
                                    <t t-if="o.decompte_btp_i"><t t-esc="o.format_monetary_value(o.decompte_btp_i)"/></t>
                                    <t t-else="">-</t>
                                </td>
                            </tr>

                            <!-- 12. TOTAL RETENUES (TR) = (G+H+I) -->
                            <tr style="border: 1.5px solid #000; font-weight: bold; background-color: #ffffff;">
                                <td style="border: 1.5px solid #000; text-align: center; padding: 6px 10px; text-transform: uppercase;">
                                    TOTAL RETENUES (TR) = (G+H+I)
                                </td>
                                <td style="border: 1.5px solid #000; text-align: right; padding: 6px 10px; font-weight: bold;">
                                    <t t-if="o.decompte_btp_tr"><t t-esc="o.format_monetary_value(o.decompte_btp_tr)"/></t>
                                    <t t-else="">-</t>
                                </td>
                            </tr>

                            <!-- 13. MONTANT NET DU PRESENT DECOMPTE A PAYER (HTVA) -->
                            <tr style="border: 1.5px solid #000; font-weight: bold; background-color: #ffffff;">
                                <td style="border: 1.5px solid #000; text-align: center; padding: 6px 10px; text-transform: uppercase;">
                                    MONTANT NET DU PRESENT DECOMPTE A PAYER (HTVA) = (MB) - (TR)
                                </td>
                                <td style="border: 1.5px solid #000; text-align: right; padding: 6px 10px; font-weight: bold;">
                                    <t t-esc="o.format_monetary_value(o.decompte_btp_net_htva)"/>
                                </td>
                            </tr>

                            <!-- 14. TVA 18% -->
                            <tr style="border: 1px solid #000; font-weight: 500;">
                                <td style="border: 1px solid #000; text-align: center; padding: 5px 10px;">TVA 18%</td>
                                <td style="border: 1px solid #000; text-align: right; padding: 5px 10px;">
                                    <t t-if="o.decompte_btp_tva"><t t-esc="o.format_monetary_value(o.decompte_btp_tva)"/></t>
                                    <t t-else="">-</t>
                                </td>
                            </tr>

                            <!-- 15. MONTANT NET DU PRESENT DECOMPTE A PAYER (TTC) -->
                            <tr style="border: 2px solid #000; font-weight: bold; font-size: 11.5px; background-color: #ffffff;">
                                <td style="border: 2px solid #000; text-align: center; padding: 7px 10px; text-transform: uppercase; font-weight: bold;">
                                    MONTANT NET DU PRESENT DECOMPTE A PAYER (TTC)
                                </td>
                                <td style="border: 2px solid #000; text-align: right; padding: 7px 10px; font-weight: bold;">
                                    <t t-esc="o.format_monetary_value(o.decompte_btp_net_ttc)"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- ARRÊTÉ LA PRÉSENTE FACTURE À LA SOMME DE (EN TOUTES LETTRES) -->
                    <div style="margin-top: 10px; margin-bottom: 35px; font-size: 11.5px; line-height: 1.5;">
                        <span>Arrêté la présente facture à la somme de :</span>
                        <span style="font-weight: bold; text-transform: uppercase; margin-left: 5px;">
                            <t t-esc="o.decompte_btp_net_lettres or ''"/>
                        </span>
                    </div>

                    <!-- BLOC LE BUREAU (ALIGNÉ EXACTEMENT COMME SUR LA PHOTO) -->
                    <table style="width: 100%; border-collapse: collapse; margin-top: 25px;">
                        <tr>
                            <td style="width: 55%;"></td>
                            <td style="width: 45%; text-align: center; vertical-align: top;">
                                <div style="font-weight: bold; font-size: 12px; text-decoration: underline; margin-bottom: 60px;">
                                    <t t-esc="o.decompte_btp_signataire_titre or 'Le Bureau'"/>
                                </div>
                                <div t-if="o.decompte_btp_signataire_nom" style="font-weight: bold; font-size: 11.5px;">
                                    <t t-esc="o.decompte_btp_signataire_nom"/>
                                </div>
                            </td>
                        </tr>
                    </table>

                </div>
            </t>
        </t>
    </template>

    <!-- Redirection automatique de l'impression standard Facture Odoo vers le template Décompte BTP -->
    <template id="report_invoice_inherit_decompte_btp" inherit_id="account.report_invoice">
        <xpath expr="//t[@t-call='account.report_invoice_document']" position="before">
            <t t-if="o.facture_modele_code == 'decompte_btp'" t-call="btp_decompte.report_facture_decompte_document" t-lang="lang">
                <t t-set="docs" t-value="o"/>
            </t>
        </xpath>
    </template>
</odoo>
